# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Chat - Ollama Configuration (Server-side only)
# Ollama must be running locally on your machine
# Install Ollama: https://ollama.ai
# Default model: llama3.2 (pull with: ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Blink UI (OPTIONAL - if using @blinkdotnew/ui)
# VITE_BLINK_PROJECT_ID=your-blink-project-id
# VITE_BLINK_PUBLISHABLE_KEY=your-blink-publishable-key

# reCAPTCHA (OPTIONAL)
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
