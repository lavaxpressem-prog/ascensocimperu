# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Blink UI (OPTIONAL - if using @blinkdotnew/ui)
# VITE_BLINK_PROJECT_ID=your-blink-project-id
# VITE_BLINK_PUBLISHABLE_KEY=your-blink-publishable-key

# reCAPTCHA (OPTIONAL)
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Google Drive API (REQUIRED for news PDF storage)
# Server-side only - NEVER use VITE_ prefix for these
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_NEWS_FOLDER_ID=your-folder-id-here

# News PDF Settings
MAX_NEWS_PDF_SIZE_MB=20
